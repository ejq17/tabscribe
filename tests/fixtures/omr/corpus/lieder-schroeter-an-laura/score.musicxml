  <credit page="1">
    <credit-words default-x="656.4376" default-y="1738.197654" justify="center" valign="top" font-size="24">3. An Laura</credit-words>
    </credit>
  <credit page="1">
    <credit-type>composer</credit-type>
    <credit-words default-x="1250.375166" default-y="1644.421647" justify="right" valign="bottom" font-size="12">Corona Elisabeth Wilhelmine Schröter</credit-words>
    </credit>
  <credit page="1">
    <credit-type>lyricist</credit-type>
    <credit-words default-x="62.500034" default-y="1638.909491" justify="left" valign="bottom" font-size="12">Anonymous</credit-words>
    </credit>
  <credit page="1">
    <credit-words default-x="656.4376" default-y="1793.319216" justify="center" valign="top" font-size="14">25 Lieder</credit-words>
    </credit>
  <credit page="1">
    <credit-words default-x="62.500034" default-y="522.239573" justify="left" valign="top" font-size="12">Milder und versöhnet
</credit-words>
    <credit-words>Wird ihr strenger Sinn,
</credit-words>
    <credit-words>Wann ich armer Knabe
</credit-words>
    <credit-words>Einst gestorben bin.
</credit-words>
    <credit-words>
</credit-words>
    <credit-words> 
</credit-words>
    <credit-words></credit-words>
    </credit>
  <credit page="1">
    <credit-words default-x="62.500034" default-y="528.405198" justify="left" valign="top" font-size="12">Denn mit lieben Herzen
</credit-words>
    <credit-words>Hat sie mich geliebt 
</credit-words>
    <credit-words>Ob sie gleich mit Zürnen,
</credit-words>
    <credit-words>Oft mich hart betrübt.
</credit-words>
    <credit-words></credit-words>
    </credit>
  <credit page="1">
    <credit-words default-x="62.500034" default-y="719.521398" justify="left" valign="top" font-size="12">Sterbend wird bedauren
</credit-words>
    <credit-words>Meine Freundin mich.
</credit-words>
    <credit-words>Und bei meinem Grabe
</credit-words>
    <credit-words>Weinen sicherlich.
</credit-words>
    <credit-words></credit-words>
    </credit>
  <credit page="1">
    <credit-words default-x="62.500034" default-y="713.356323" justify="left" valign="top" font-size="12">Schmolz' es wie die Zähre
</credit-words>
    <credit-words>Die dem Aug entschleicht:
</credit-words>
    <credit-words>Aller Klagen Ende
</credit-words>
    <credit-words>Wäre dann erreicht.
</credit-words>
    <credit-words></credit-words>
    </credit>
  <credit page="1">
    <credit-words default-x="62.500034" default-y="714.897636" justify="left" valign="top" font-size="12">Still verweinte Tränen
</credit-words>
    <credit-words>Keine Seele sieht;
</credit-words>
    <credit-words>Flöhe doch mein Leben
</credit-words>
    <credit-words>Wie ein Seufzer flieht.
</credit-words>
    <credit-words></credit-words>
    </credit>
  <credit page="1">
    <credit-type>rights</credit-type>
    <credit-words default-x="656.4376" default-y="125.000067" justify="center" valign="bottom" font-size="8">OpenScore (CC0)</credit-words>
    </credit>
